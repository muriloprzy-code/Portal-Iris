zn "%SYS"
do $System.OBJ.Load("/tmp/zpm.xml", "ck")
zpm "enable -map -globally"

; Enable interoperability before the package compiles (the production classes extend Ens.*).
; EnableNamespace is used instead of Interop=1 in merge.cpf: on IRIS for Health, Interop=1
; makes a Foundation namespace whose own production would block the portal production.
set sc = ##class(%EnsembleMgr).EnableNamespace("MYOWN", 0, , 0, 0)
if 'sc write !, "EnableNamespace MYOWN failed: ", $System.Status.GetErrorText(sc), !

zn "MYOWN"
; One module. The AI Hub engine is compiled by the module itself, only where the %AI package
; exists (MyOwn.Installer.LoadAIHub); elsewhere Rules decide. -dev keeps its test classes.
; zpm "...":pTerminateOnError:pHaltOnComplete: errors end the build with a non-zero exit code.
zpm "load /home/irisowner/dev -v -dev":1:0
; The portal test classes (MyOwn.Test, Scope="test" in module.xml) are not loaded by -dev in
; IPM 0.10, and the test scripts need them: loaded here, so the image has them and a registry
; install does not. finish-build.script checks they compiled.
set sc = $System.OBJ.LoadDir("/home/irisowner/dev/src/objectscript/MyOwn/Test/", "ck/multicompile=0", .errors, 1)
if 'sc write !, "MyOwn Portal test classes did not compile: ", $System.Status.GetErrorText(sc), !
halt
