[Actions]
CreateResource:Name=%DB_MYOWN_DATA,Description="MyOwn Portal data database"
CreateDatabase:Name=MYOWN_DATA,Directory=/usr/irissys/mgr/MYOWN_DATA,Resource=%DB_MYOWN_DATA
CreateResource:Name=%DB_MYOWN_CODE,Description="MyOwn Portal code database"
CreateDatabase:Name=MYOWN_CODE,Directory=/usr/irissys/mgr/MYOWN_CODE,Resource=%DB_MYOWN_CODE
CreateNamespace:Name=MYOWN,Globals=MYOWN_DATA,Routines=MYOWN_CODE,Interop=0
