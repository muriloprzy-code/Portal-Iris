; Runs after iris.script in a separate IRIS session. Runtime credentials are
; initialized by iris-main because durable %SYS is created on first startup.
zn "MYOWN"

; Remove the transient build hostname before the image is captured.
Set tSC = ##class(MyOwn.Installer).PrepareForContainerBundling()
Write !, "PrepareForContainerBundling: ", $Select(tSC=1:"OK", 1:$System.Status.GetErrorText(tSC))

halt
