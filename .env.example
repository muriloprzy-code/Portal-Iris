# Optional Docker overrides
# Load the contest EAP image locally, then tag it with this exact name.
# IRIS alternative: iris-community:2026.3.0AI.154.0
IRIS_IMAGE=irishealth-community:2026.3.0AI.154.0
MYOWN_DATA_VOLUME=myown-portal-data
IRIS_WEB_PORT=52774
IRIS_SUPERSERVER_PORT=1973
# The ports are published on this computer only. Change only to expose the portal on purpose,
# after replacing MYOWN_DEMO_PASSWORD below.
IRIS_BIND_ADDRESS=127.0.0.1

# Initial _SYSTEM password for the local Docker demo. The value below is a
# public, well-known convenience credential committed for local evaluation.
# Copy this file to the git-ignored .env and replace the value before exposing
# the container to another computer or network.
MYOWN_DEMO_PASSWORD=ChangeMe2026!

# AI Hub provider settings. Keep the real key only in your git-ignored .env.
# The portal remains functional with the deterministic Rules engine when blank.
# Tested by us: Gemini, gemini-3.5-flash-lite (free tier, 2026-10-28; gemini-3.8-flash was used
# 2026-10-21 to 2026-10-24 and later stopped answering). Accepted through the same %AI provider
# path but not tested by us: openai (for example MYOWN_AI_MODEL=gpt-4.1-mini), anthropic, bedrock.
MYOWN_AI_PROVIDER=gemini
MYOWN_AI_MODEL=gemini-3.5-flash-lite
MYOWN_AI_API_KEY=

# Engine behavior (all optional). MYOWN_AI_MODE=replay answers from recorded real decisions
# (aihub/fixtures) with no key and no network (demo and tests). The timeout (5-55 s) is the
# portal's own deadline per decision; Rules decide when it is exceeded (on the Gemini free tier
# S2 took 23 to 26 s, so use 40 to see the AI decision there). Thinking: low, high or default.
MYOWN_AI_MODE=live
MYOWN_AI_TIMEOUT_SECONDS=20
MYOWN_AI_MAX_OUTPUT_TOKENS=400
MYOWN_AI_THINKING=low

# Public demo (for whoever hosts the online demo). MYOWN_DEMO_MODE=1 creates the low-privilege
# "demo" account and restricts confirmations to synthetic targets. Generate the password with
# scripts/New-DemoPassword.ps1, which writes it to .env only; never use the _SYSTEM password here.
MYOWN_DEMO_MODE=0
MYOWN_DEMO_USER_PASSWORD=
MYOWN_DEMO_RESET_HOURS=6
MYOWN_DEMO_SIMULATIONS_PER_MINUTE=6
