# Optional Docker overrides
IRIS_IMAGE=containers.intersystems.com/intersystems/iris-community:latest-em
IRIS_WEB_PORT=52774
IRIS_SUPERSERVER_PORT=1973

# Initial _SYSTEM password set inside the local Docker demo container.
# This is a build-time default for local evaluation only. Copy this file
# to .env and change it before using the container for anything beyond
# a throwaway local demo. It is never committed to source control.
MYOWN_DEMO_PASSWORD=ChangeMe2026!
