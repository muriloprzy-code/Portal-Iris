# Optional Docker overrides
# Load the contest EAP image locally, then tag it with this exact name.
# IRIS alternative: iris-community:2026.3.0AI.154.0
IRIS_IMAGE=irishealth-community:2026.3.0AI.154.0
MYOWN_DATA_VOLUME=myown-portal-data
IRIS_WEB_PORT=52774
IRIS_SUPERSERVER_PORT=1973

# Initial _SYSTEM password for the local Docker demo. The value below is a
# public, well-known convenience credential committed for local evaluation.
# Copy this file to the git-ignored .env and replace the value before exposing
# the container to another computer or network.
MYOWN_DEMO_PASSWORD=ChangeMe2026!

# AI Hub provider settings. Keep the real key only in your git-ignored .env.
# The portal remains functional with the deterministic Rules engine when blank.
MYOWN_AI_PROVIDER=openai
MYOWN_AI_MODEL=gpt-4.1-mini
MYOWN_AI_API_KEY=
