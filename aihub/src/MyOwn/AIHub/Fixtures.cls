/// Recorded model answers for MYOWN_AI_MODE=replay (no key, no network). One fixture per
/// demonstration scenario S1..S10, each with its header: status (recorded, pending or
/// not_applicable), provider, model, recordedAt (UTC), source of the real call, how its context
/// relates to the scenario and the substitutions made (task id, user and role become
/// placeholders; nothing else in the answer is changed). A scenario without a recorded answer
/// makes the engine fall back to Rules (replay_missing) instead of inventing one. The "tests"
/// cases are not model answers: they drive the fallback and policy checks.
/// <p>The XData below is generated by scripts/Build-ReplayFixtures.ps1 from aihub/fixtures/*.json;
/// record a scenario with scripts/Record-ReplayFixtures.ps1. Do not edit it by hand.</p>
Class MyOwn.AIHub.Fixtures
{

/// Fixture key for a context: "test:<case>" for context.replayCase (tests only), the scenario
/// name for a demonstration scenario, otherwise the scenario whose situation matches.
ClassMethod Pick(workflow As %String, context As %DynamicObject) As %String
{
    If context.%Get("replayCase") '= "" Quit "test:" _ context.replayCase
    If context.%Get("scenario") ? 1"S"1.2N Quit context.scenario
    If workflow = "access-request" {
        If context.%Get("prohibited") Quit "S7"
        Quit $Select(context.%Get("riskFloor") = "low": "S5", $IsObject(context.%Get("untrustedData")) && (context.untrustedData.%Get("justification") '= ""): "S9", 1: "S6")
    }
    Set task = context.%Get("task")
    If $IsObject(task) {
        If task.%Get("suspended") && task.%Get("lastRunOk") Quit "S3"
        If task.%Get("consecutiveFailures") >= 3 Quit "S2"
    }
    If $IsObject(context.%Get("logs")) && (context.logs.%Size() > 0) Quit "S8"
    Set anomalies = context.%Get("anomalies")
    If $IsObject(anomalies) && (anomalies.%Size() > 0) {
        Set critical = 0
        For index = 0:1:(anomalies.%Size() - 1) {
            If anomalies.%Get(index).%Get("severity") = "critical" Set critical = 1
        }
        Quit $Select(critical: "S1", 1: "S10")
    }
    Quit "S4"
}

/// The fixture for a key from Pick().
ClassMethod Get(key As %String, Output fixture As %DynamicObject) As %Status
{
    Set fixture = ""
    Set tSC = ..All(.all)
    If $$$ISERR(tSC) Quit tSC
    If $Extract(key, 1, 5) = "test:" {
        Set fixture = all.tests.%Get($Extract(key, 6, *))
    } Else {
        Set fixture = all.scenarios.%Get(key)
    }
    If '$IsObject(fixture) Quit $$$ERROR($$$GeneralError, "unknown replay case")
    Quit $$$OK
}

/// Header of every scenario fixture (no answers): which are recorded, from which model and when.
ClassMethod Inventory() As %String [ SqlProc ]
{
    Set list = []
    If $$$ISERR(..All(.all)) Quit list.%ToJSON()
    For index = 1:1:10 {
        Set fixture = all.scenarios.%Get("S" _ index)
        Set item = {"scenario": ("S" _ index), "status": ($Select($IsObject(fixture): fixture.%Get("status"), 1: "missing"))}
        If $IsObject(fixture) {
            For key = "provider", "model", "recordedAt", "source", "context" {
                If fixture.%Get(key) '= "" Do item.%Set(key, fixture.%Get(key))
            }
        }
        Do list.%Push(item)
    }
    Quit list.%ToJSON()
}

/// Replaces {{taskId}}, {{requester}} and {{roleRequested}} with JSON-escaped context values.
ClassMethod Fill(raw As %String, context As %DynamicObject) As %String
{
    Set taskId = ""
    Set candidates = context.%Get("candidates")
    If $IsObject(candidates) && (candidates.%Size() > 0) Set taskId = candidates.%Get(0).%Get("id")
    If (taskId = "") && $IsObject(context.%Get("task")) Set taskId = context.task.%Get("id")
    Set raw = $Replace(raw, "{{taskId}}", $ZConvert(taskId, "O", "JSON"))
    Set raw = $Replace(raw, "{{requester}}", $ZConvert(context.%Get("requester"), "O", "JSON"))
    Quit $Replace(raw, "{{roleRequested}}", $ZConvert(context.%Get("roleRequested"), "O", "JSON"))
}

ClassMethod All(Output all As %DynamicObject) As %Status [ Private ]
{
    Set all = ""
    Set xdata = ##class(%Dictionary.CompiledXData).%OpenId($ClassName() _ "||Cases")
    If '$IsObject(xdata) Quit $$$ERROR($$$GeneralError, "fixtures not found")
    Set all = {}.%FromJSON(xdata.Data)
    Quit $$$OK
}

